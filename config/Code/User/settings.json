    "editor.tokenColorCustomizations": {
        "comments": {
            "foreground": "#4a7a5a",
            "fontStyle": "italic"
        },
        "strings": "#00cc33",
        "numbers": "#ffaa00",
        "keywords": "#00ff41",
        "types": "#00ff41",
        "functions": "#c0ffcc",
        "variables": "#c0ffcc",
        "textMateRules": [
            {
                "scope": ["comment", "comment.block", "comment.line"],
                "settings": { "foreground": "#4a7a5a", "fontStyle": "italic" }
            },
            {
                "scope": ["string", "string.quoted"],
                "settings": { "foreground": "#00cc33" }
            },
            {
                "scope": ["constant.numeric", "constant.language"],
                "settings": { "foreground": "#ffaa00" }
            },
            {
                "scope": ["keyword", "keyword.control", "storage.type", "storage.modifier"],
                "settings": { "foreground": "#00ff41", "fontStyle": "bold" }
            },
            {
                "scope": ["entity.name.function", "support.function", "meta.function-call"],
                "settings": { "foreground": "#c0ffcc" }
            },
            {
                "scope": ["variable", "variable.other", "variable.parameter"],
                "settings": { "foreground": "#c0ffcc" }
            },
            {
                "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type"],
                "settings": { "foreground": "#00ff41" }
            },
            {
                "scope": ["punctuation", "punctuation.definition", "meta.brace"],
                "settings": { "foreground": "#4a7a5a" }
            },
            {
                "scope": ["invalid", "invalid.illegal"],
                "settings": { "foreground": "#ff0033" }
            },
            {
                "scope": ["markup.heading", "entity.name.section"],
                "settings": { "foreground": "#00ff41", "fontStyle": "bold" }
            },
            {
                "scope": ["markup.bold"],
                "settings": { "foreground": "#00ff41", "fontStyle": "bold" }
            },
            {
                "scope": ["markup.italic"],
                "settings": { "foreground": "#c0ffcc", "fontStyle": "italic" }
            },
            {
                "scope": ["markup.inserted"],
                "settings": { "foreground": "#00ff41" }
            },
            {
                "scope": ["markup.deleted"],
                "settings": { "foreground": "#ff0033" }
            },
            {
                "scope": ["markup.changed"],
                "settings": { "foreground": "#ffaa00" }
            },
            {
                "scope": ["entity.other.attribute-name", "meta.tag"],
                "settings": { "foreground": "#ffaa00" }
            }
        ]
    }
}
